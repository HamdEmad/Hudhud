# Hudhud - Environment Variables Template
# Copy this file to .env and insert your real API keys.
# Any provider without a configured key is automatically skipped in the fallback chain.

# Google Custom Search Engine (CSE)
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_CX=your_google_cse_cx_search_engine_id_here

# SerpAPI (Google Search API - 250 free searches/month)
# https://serpapi.com/
SERP_API_KEY=your_serpapi_key_here

# Tavily AI Search (1,000 free searches/month)
# https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl Search API
# https://www.firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Jina AI Search API
# https://jina.ai/
JINA_API_KEY=your_jina_api_key_here

# Note: DuckDuckGo requires NO API KEY (runs out-of-the-box via ddgs)
